{
  "name": "mcpit-registry",
  "version": "0.1.0",
  "private": true,
  "description": "mcpit registry: sitepack versions, submit gate, screening agent and console (Cloudflare Worker + Vue 3)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "check": "vp check && tsc --noEmit -p .",
    "db:migrate:local": "wrangler d1 migrations apply mcpit --local",
    "deploy": "vp build && wrangler deploy"
  },
  "dependencies": {
    "agents": "^0.26.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "^1.0.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
