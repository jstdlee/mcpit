{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpit-registry",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/.well-known/*", "/agents/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcpit",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": { "bindings": [{ "name": "SCREENER", "class_name": "ScreeningAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScreeningAgent"] }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "PUBLIC_URL": "https://tomcp.ohmyai.xyz", "DECISION_MODEL": "@cf/cloudflare/clef-flash" },
  "observability": { "enabled": true },
}
